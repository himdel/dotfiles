#!/bin/bash
cd "$( dirname "$0" )"

find etc/ -type f | while read f; do
  cmp -s "$f" /"$f" && continue

  echo "vimdiff $f"
  vimdiff "$f" /"$f" </dev/tty >/dev/tty 2>/dev/tty
done

find wallpapers/ -type f | while read f; do
  cmp -s "$f" ~/"$f" && continue

  echo "vimdiff $f"
  vimdiff "$f" ~/"$f" </dev/tty >/dev/tty 2>/dev/tty
done

# home/_foo is ~/.foo - only the leading underscore is a dot
#
# NB: a few files are committed with placeholder values, so vimdiff shows the
# same diff every run. Read before taking the local side.
find home/ -type f | while read f; do
  h=`echo "$f" | sed 's|^home/_|.|'`
  cmp -s "$f" ~/"$h" && continue

  echo "vimdiff $f"
  vimdiff "$f" ~/"$h" </dev/tty >/dev/tty 2>/dev/tty
done

crontab -l | diff -q crontab - || EDITOR="vimdiff `realpath crontab`" crontab -e
apt-mark showmanual | sort -u > dependencies.`hostname -s`
sudo apt install `cat dependencies`
