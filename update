#!/bin/bash
cd "$( dirname "$0" )"

HOST=`hostname -s`
MISSING=()

# Deliberately different on every box, so never reconciled. Each host keeps its own:
#   hosts                     - own 127.0.1.1, own hvpn managed blocks
#   wpa_supplicant.conf       - repo is the bare template, each box has its own networks
#   70-persistent-net.rules   - orome appends an iw power_save rule lorien does not want
per_host() {
  case "$1" in
    etc/hosts) return 0 ;;
    etc/wpa_supplicant/wpa_supplicant.conf) return 0 ;;
    etc/udev/rules.d/70-persistent-net.rules) return 0 ;;
  esac
  return 1
}

# $1 repo copy, $2 the live file it maps to
review() {
  per_host "$1" && return

  # absent here is usually "belongs to another box", not "needs installing", so just
  # collect it. cp by hand if this host really wants it.
  [ -e "$2" ] || { MISSING+=("$1"); return; }

  cmp -s "$1" "$2" && return

  echo "vimdiff $1"
  vimdiff "$1" "$2" </dev/tty >/dev/tty 2>/dev/tty
}

while read f; do review "$f" "/$f"; done < <(find etc/ -type f)

while read f; do review "$f" ~/"$f"; done < <(find wallpapers/ -type f)

# home/_foo is ~/.foo - only the leading underscore is a dot. Some of these are
# symlinks back into the repo, which cmp resolves, so they simply never differ.
#
# NB: a few files are committed with placeholder values, so vimdiff shows the
# same diff every run. Read before taking the local side.
while read f; do
  review "$f" ~/"`echo "$f" | sed 's|^home/_|.|'`"
done < <(find home/ -type f)

# one shared crontab, every entry self-guarding, so it is safe anywhere. A host that
# needs a different set (orome takes the personal half, not the work half) gets a
# crontab.<host> beside it.
CRONTAB=crontab
[ -e "crontab.$HOST" ] && CRONTAB="crontab.$HOST"
crontab -l | diff -q "$CRONTAB" - || EDITOR="vimdiff `realpath "$CRONTAB"`" crontab -e

apt-mark showmanual | sort -u > dependencies."$HOST"
sudo apt install `cat dependencies`

# groups only exist once the package that creates them is in, hence after the install
for g in \
  audio bluetooth cdrom dip docker floppy input kvm motion netdev ollama \
  pipewire plugdev pulse pulse-access render sudo users video \
; do
  getent group "$g" > /dev/null || continue
  id -nG | tr ' ' '\n' | grep -qx "$g" || sudo adduser "$USER" "$g"
done

[ ${#MISSING[@]} -eq 0 ] || printf 'not on %s, ignored: %s\n' "$HOST" "${MISSING[*]}"
