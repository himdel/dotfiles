# Ctrl + MouseWheel does nothing (for chrome)
""
  control + b:4 (mouse)

""
  control + b:5 (mouse)

# Shift + Ctrl + MouseWheel = volume
"mpc volume +2"
  shift + control + b:4 (mouse)

"mpc volume -2"
  shift + control + b:5 (mouse)

# lock
"slock"
  Mod4 + l

"slock"
  Print

# magic keys
"google-chrome-beta"
  XF86HomePage

"volume toggle"
  XF86AudioMute

"volume down"
  XF86AudioLowerVolume

"volume up"
  XF86AudioRaiseVolume

"playerctl play-pause"
  XF86AudioPlay

"playerctl play-pause"
  Mod2 + XF86AudioPlay

### modifiers
#
# shift       Shift_L,  Shift_R
# lock        Caps_Lock
# control     Control_L,  Control_R
# mod1        Alt_L,  Alt_R,  Alt_L,  Meta_L
# mod2        Num_Lock
# mod3        ISO_Level5_Shift
# mod4        Super_L,  Super_R,  Super_L
# mod5        ISO_Level3_Shift
