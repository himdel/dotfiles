# potato woody sarge etch lenny squeeze wheezy jessie stretch buster
# bullseye bookworm trixie forky ... sid

# stable = trixie
deb http://ftp.cz.debian.org/debian/ trixie main contrib non-free non-free-firmware
deb http://ftp.cz.debian.org/debian/ trixie-backports main contrib non-free non-free-firmware
deb http://ftp.cz.debian.org/debian/ trixie-updates main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware

# testing = forky ; next = ?
deb http://ftp.cz.debian.org/debian/ forky main contrib non-free non-free-firmware
deb http://ftp.cz.debian.org/debian/ forky-backports main contrib non-free non-free-firmware
deb http://ftp.cz.debian.org/debian/ forky-updates main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security forky-security main contrib non-free non-free-firmware

# unstable = sid; experimental
deb http://ftp.cz.debian.org/debian/ sid main contrib non-free non-free-firmware
deb http://ftp.debian.org/debian/ experimental main contrib non-free non-free-firmware

# sources
deb-src http://ftp.cz.debian.org/debian/ sid main contrib non-free non-free-firmware
