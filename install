#!/bin/bash
cd "$( dirname "$0" )"

confirm() {
  read -p "$1 [y/N] " a
  [ "$a" = y ] || [ "$a" = Y ]
}

## su -
## systemctl disable wpa_supplicant
## vi /etc/network/interfaces
## vi /etc/wpa_supplicant/wpa_supplicant.conf
## vi /etc/udev/rules.d/70-persistent-net.rules
## ifup -a
## ip addr ls
## apt update
## apt install aptitude git ssh sudo vim net-tools
## grep himdel /etc/sudoers || echo 'himdel ALL=NOPASSWD: ALL' >> /etc/sudoers
## vim /etc/dhcp/dhclient.conf # supersede dns

## ssh-keygen, add to github, clone doftiles
## sudoers
##   also Defaults !admin_flag

sudo ln -svf /usr/share/zoneinfo/Etc/UTC /etc/localtime
sudo sh -c 'echo Etc/UTC > /etc/timezone'

sudo dpkg --add-architecture i386
sudo apt update

sudo apt install steam:i386

sudo apt install lua5.2 luarocks lua-socket lua-xmlrpc lua-zlib mpv
sudo ln -s /usr/share/lua/5.1/xmlrpc /usr/share/lua/5.2/xmlrpc
mkdir -p ~/.config/mpv/scripts
git clone https://github.com/rumkex/osdb-mpv.git ~/.config/mpv/scripts

for val in \
  fs.inotify.max_user_watches=749973 \
  fs.inotify.max_user_instances=512 \
  kernel.keys.maxkeys=2000 \
; do
  grep "$val" /etc/sysctl.conf || ( echo "$val" | sudo tee -a /etc/sysctl.conf && sudo sysctl -p )
done

# stock files we only tweak, so no point keeping a copy in etc/
grep -q 'GRUB_CMDLINE_LINUX="apparmor=0"' /etc/default/grub || (
  sudo sed -i 's/^GRUB_CMDLINE_LINUX=.*/GRUB_CMDLINE_LINUX="apparmor=0"/' /etc/default/grub && sudo update-grub
)
# shortnames.conf ships pointing at docker.io, and we ban that in /etc/hosts
sudo sed -i 's|= "docker\.io/|= "mirror.gcr.io/|' /etc/containers/registries.conf.d/shortnames.conf

wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | sudo apt-key add -
wget https://dl.google.com/linux/direct/google-chrome-beta_current_amd64.deb
sudo dpkg -i google-chrome-beta_current_amd64.deb
rm -vf google-chrome-beta_current_amd64.deb
# chrome writes its own sources.list.d entry, so that one is not tracked in etc/

# keys for the sources.list.d files etc/ does track. the keyrings themselves stay out
# of the repo, always fetch the current one. paths have to match the signed-by= in
# etc/apt/sources.list.d/*.list
sudo mkdir -p /etc/apt/keyrings
fetchkey() {
  curl -fsSL "$1" | gpg --dearmor | sudo tee "$2" > /dev/null
}
fetchkey https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  /etc/apt/keyrings/githubcli-archive-keyring.gpg
fetchkey https://packages.cloud.google.com/apt/doc/apt-key.gpg \
  /usr/share/keyrings/cloud.google.gpg
fetchkey https://pkgs.netbird.io/debian/public.key \
  /usr/share/keyrings/netbird-archive-keyring.gpg

[ -e ~/bin ] || ln -sv ~/dotfiles/bin ~/bin

sudo ln -sv ~/bin/rename.perl /usr/local/bin/rename
sudo ln -sv ~/bin/xdg-open /usr/local/bin/

# podman provides `docker compose`, but half the world still calls the hyphenated one
sudo tee /usr/local/bin/docker-compose > /dev/null <<'EOF'
#!/bin/sh
docker compose "$@"
EOF
sudo chmod +x /usr/local/bin/docker-compose

# groups, union of what lorien and orome have. some only exist once the matching
# package is in, so this is worth a second run after ./update
for g in \
  audio bluetooth cdrom dip docker floppy input kvm motion netdev ollama \
  pipewire plugdev pulse pulse-access render sudo users video \
; do
  getent group "$g" > /dev/null || continue
  id -nG | tr ' ' '\n' | grep -qx "$g" || sudo adduser "$USER" "$g"
done

# TODO link home stuff

./update

# ./update put the tracked sources.list.d files in place, so now the repos they point
# at are usable
sudo apt update
sudo apt install `cat dependencies`

# rm -f /usr/lib/python3*/EXTERNALLY-MANAGED
# TODO install fbxkb (no longer in deb, see patches/fbxkb.patch)

gio mime x-scheme-handler/http google-chrome-beta.desktop
gio mime x-scheme-handler/https google-chrome-beta.desktop
xdg-mime default google-chrome-beta.desktop x-scheme-handler/http
xdg-mime default google-chrome-beta.desktop x-scheme-handler/https

# no longer in util-linux
sudo ln -s /usr/bin/busybox /usr/local/bin/last

# rbenv, perlbrew and cpanminus come from dependencies. nvm and uv do not ship in
# debian, and _bashrc sources both, so they need their upstream installers.
if [ ! -s ~/.nvm/nvm.sh ] && confirm "curl | bash the nvm installer?"; then
  # bump the tag, nvm wants a pinned one
  curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.7/install.sh | bash
  . ~/.nvm/nvm.sh && nvm install --lts
fi

if ! command -v uv > /dev/null && confirm "curl | sh the uv installer?"; then
  curl -LsSf https://astral.sh/uv/install.sh | sh
fi

# no deb and no crate worth the build time, so take the release binary
if ! command -v ast-grep > /dev/null; then
  mkdir -p ~/.local/bin
  curl -fsSL -o /tmp/ast-grep.zip \
    https://github.com/ast-grep/ast-grep/releases/latest/download/app-x86_64-unknown-linux-gnu.zip
  unzip -o /tmp/ast-grep.zip -d ~/.local/bin ast-grep sg
  rm -f /tmp/ast-grep.zip
fi
