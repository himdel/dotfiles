#!/bin/sh

# run after `hardlink -cO .`, in the same dir
# no params
# tac is optional
# only works when inode number length is <= 10 decimal digits
# pipe output to sh after checking
# removes all but one file from each group with the same inode

find -type f -print0 | xargs -0 ls -i | sort | sed 's/ /          /' | uniq -D -w 10 | tac | perl -ne 'chomp; /^(\d+) +(.*)$/; $cur = $1; if ($cur ne $last) { print "echo keep: \"$2\"\n"; } else { print "rm -v \"$2\"\n"; } $last = $cur'
