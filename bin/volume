#!/bin/bash

# pulse/pipewire via pactl; the alsa (amixer) version is gone with alsa-utils

SINK=@DEFAULT_SINK@

notify() {
  notify-send -t 800 "$@"
}

case "$1" in
"")
  # volume - get volume
  pactl get-sink-volume "$SINK" | grep -m1 -oE '[0-9]+%' | head -n1 | tr -d '%'
  ;;
"muted")
  # volume muted - get muted status
  pactl get-sink-mute "$SINK" | sed -e 's/^Mute: yes$/muted/' -e 's/^Mute: no$/unmuted/'
  ;;

"toggle")
  # volume toggle - toggle mute
  pactl set-sink-mute "$SINK" toggle
  notify 'mute toggled to '$(volume muted)
  ;;
"up")
  # volume up - increase volume by 5%
  pactl set-sink-volume "$SINK" +5%
  notify 'volume up to '$(volume)'%'
  ;;
"down")
  # volume down - decrease volume by 5%
  pactl set-sink-volume "$SINK" -5%
  notify 'volume down to '$(volume)'%'
  ;;

[0-9]*)
  # volume 50 - set volume to 50%
  pactl set-sink-volume "$SINK" "$1"%
  notify 'volume set to '$(volume)'%'
  ;;

*) # else
  echo "$(basename "$0"): invalid args: $1" 1>&2
  exit 1
  ;;
esac
